t"><link rel="preload" href="/assets/fonts/sora-latin-variable.woff2" as="font" type="font/woff2" crossorigin><link rel="preload" href="/assets/fonts/inter-latin-variable.woff2" as="font" type="font/woff2" crossorigin><link rel="stylesheet" href="/assets/site.css?v=20260726-3"><script src="/assets/theme-init.js?v=20260726-3"></script><script type="application/ld+json">{"@context":"https://schema.org","@type":"HowTo","name":"Como usar o Rumman","description":"Guia operacional do ERP Android Rumman.","step":[{"@type":"HowToStep","name":"Conta e empresa","text":"No primeiro acesso ou ao trocar os dados do negócio."},{"@type":"HowToStep","name":"Clientes","text":"Antes de criar uma proposta, ordem ou locação."},{"@type":"HowToStep","name":"Catálogo e kits","text":"Para padronizar produtos, serviços e combinações vendidas juntas."},{"@type":"HowToStep","name":"Da proposta ao recebimento","text":"Quando um pedido precisa virar execução e cobrança."},{"@type":"HowToStep","name":"Estoque por local","text":"Ao distribuir materiais entre depósito, loja, veículo ou evento."},{"@type":"HowToStep","name":"Compras","text":"Quando a reposição precisa envolver fornecedor, prazo e caixa."},{"@type":"HowToStep","name":"Locações","text":"Para reservar um item por período e acompanhar sua devolução."},{"@type":"HowToStep","name":"Hoje no Rumman","text":"No início do dia e antes de encerrar o expediente."},{"@type":"HowToStep","name":"Proteção dos dados","text":"Antes de trocar o aparelho ou compartilhar a operação com a equipe."}]}</script></head><body><a class="skip-link" href="#conteudo">Ir para o conteúdo</a><header class="topbar"><nav class="nav" aria-label="Navegação principal"><a class="brand" href="/" aria-label="Rumman — início"><span class="brand-icon"><img src="/assets/icon-192.png" width="192" height="192" alt=""></span><span class="brand-name">Rumman</span></a><div class="nav-panel" id="primary-navigation" data-menu-panel data-open="false"><div class="nav-links"><a class="nav-link" href="/">Início</a><a class="nav-link" href="/recursos">Recursos</a><a class="nav-link" href="/como-funciona">Como funciona</a><a class="nav-link" href="/casos-de-uso">Casos de uso</a><a class="nav-link" href="/planos">Planos</a><a class="nav-link" href="/blog/">Blog</a></div><a class="nav-cta" href="/planos">Conhecer o Rumman</a></div><div class="nav-controls"><button class="theme-toggle" type="button" data-theme-toggle data-label-light="Usar tema claro" data-label-dark="Usar tema escuro" aria-label="Usar tema escuro" title="Usar tema escuro"><span aria-hidden="true">☾</span></button><button class="menu-toggle" type="button" data-menu-toggle aria-controls="primary-navigation" aria-expanded="false" aria-label="Abrir menu"><span></span><span></span><span></span></button></div></nav></header><main id="conteudo"><section class="page-hero marketing-hero"><div class="wrap page-hero-inner"><div><p class="eyebrow">Como usar</p><h1>Um guia direto para organizar a operação no Rumman.</h1><p class="hero-lead">Veja quando usar cada área, onde tocar e o que fica registrado. As ações importantes continuam sob sua confirmação.</p></div><div class="page-symbol" aria-hidden="true"><img src="/assets/illustration-help.svg" width="240" height="180" alt="" loading="lazy"></div></div></section><section class="section guide-section"><div class="wrap"><div class="guide-grid"><article class="guide-card"><span class="feature-code">01</span><h2>Conta e empresa</h2><dl><dt>Quando usar</dt><dd>No primeiro acesso ou ao trocar os dados do negócio.</dd><dt>Onde tocar</dt><dd>Mais → Minha conta → Perfil da empresa.</dd><dt>O que registra</dt><dd>Conta, workspace, perfil e preferências de acesso.</dd></dl></article><article class="guide-card"><span class="feature-code">02</span><h2>Clientes</h2><dl><dt>Quando usar</dt><dd>Antes de criar uma proposta, ordem ou locação.</dd><dt>Onde tocar</dt><dd>Clientes → Novo cliente.</dd><dt>O que registra</dt><dd>Nome, CPF/CNPJ opcional, telefone, endereço, empresa, observações e tags.</dd></dl></article><article class="guide-card"><span class="feature-code">03</span><h2>Catálogo e kits</h2><dl><dt>Quando usar</dt><dd>Para padronizar produtos, serviços e combinações vendidas juntas.</dd><dt>Onde tocar</dt><dd>Operações → Catálogo → Novo item.</dd><dt>O que registra</dt><dd>Tipo, imagem opcional, preço, estoque mínimo e componentes físicos dos kits.</dd></dl></article><article class="guide-card"><span class="feature-code">04</span><h2>Da proposta ao recebimento</h2><dl><dt>Quando usar</dt><dd>Quando um pedido precisa virar execução e cobrança.</dd><dt>Onde tocar</dt><dd>Operações → Orçamentos → Aprovar e converter.</dd><dt>O que registra</dt><dd>Cliente, itens, ordem, reserva, separação, saída, conta a receber e receita.</dd></dl></article><article class="guide-card"><span class="feature-code">05</span><h2>Estoque por local</h2><dl><dt>Quando usar</dt><dd>Ao distribuir materiais entre depósito, loja, veículo ou evento.</dd><dt>Onde tocar</dt><dd>Operações → Estoque → Almoxarifado por local.</dd><dt>O que registra</dt><dd>Saldo por local, transferências, reservas, disponibilidade e movimentações.</dd></dl></article><article class="guide-card"><span class="feature-code">06</span><h2>Compras</h2><dl><dt>Quando usar</dt><dd>Quando a reposição precisa envolver fornecedor, prazo e caixa.</dd><dt>Onde tocar</dt><dd>Operações → Compras → Novo pedido.</dd><dt>O que registra</dt><dd>Fornecedor, itens, previsão, recebimento, custo médio e conta a pagar.</dd></dl></article><article class="guide-card"><span class="feature-code">07</span><h2>Locações</h2><dl><dt>Quando usar</dt><dd>Para reservar um item por período e acompanhar sua devolução.</dd><dt>Onde tocar</dt><dd>Operações → Locações → Nova locação.</dd><dt>O que registra</dt><dd>Cliente, período, local, retirada ou entrega, retorno, recebimento e conclusão.</dd></dl></article><article class="guide-card"><span class="feature-code">08</span><h2>Hoje no Rumman</h2><dl><dt>Quando usar</dt><dd>No início do dia e antes de encerrar o expediente.</dd><dt>Onde tocar</dt><dd>Início → Hoje no Rumman.</dd><dt>O que registra</dt><dd>Não cria fatos sozinho: prioriza registros existentes e abre o módulo correto.</dd></dl></article><article class="guide-card"><span class="feature-code">09</span><h2>Proteção dos dados</h2><dl><dt>Quando usar</dt><dd>Antes de trocar o aparelho ou compartilhar a operação com a equipe.</dd><dt>Onde tocar</dt><dd>Mais → Minha conta → Backup, equipe ou sincronização.</dd><dt>O que registra</dt><dd>Arquivo .rumman criptografado, pasta escolhida, workspace, papéis, outbox e conflitos.</dd></dl></article></div></div></section><section class="section app-screens-section"><div class="wrap"><div class="section-head"><p class="eyebrow">Telas atuais do aplicativo</p><h2>Estoque por local e inventário físico.</h2><p class="lead">Capturas reais da versão atual de QA, sem dados pessoais. O fluxo preserva o saldo consolidado e mantém cada divergência auditável.</p></div><div class="screen-gallery"><figure><img src="/screenshots/estoque-por-local.png" width="1080" height="2400" loading="lazy" alt="Tela do Rumman com saldo de estoque por depósito e almoxarifado"><figcaption>Saldo por local, transferência interna e acesso ao inventário.</figcaption></figure><figure><img src="/screenshots/inventario-fisico.png" width="1080" height="2400" loading="lazy" alt="Tela do Rumman durante a conferência de inventário físico"><figcaption>Contagem física com diferença e ajuste rastreável.</figcaption></figure></div></div></section><section class="final-cta"><div class="wrap final-cta-inner"><div><p class="eyebrow">Rumman · ERP Inteligente Guiado</p><h2>Gestão clara para trabalhar com menos atrito.</h2><p>Organize clientes, caixa, documentos e decisões do dia a dia em uma experiência Android guiada.</p></div><a class="button primary" href="mailto:e-mail@rumman.app.br?subject=Quero%20conhecer%20o%20Rumman">Falar com o Rumman</a></div></section></main