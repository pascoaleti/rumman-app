  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self' https://cloudflareinsights.com; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' https://static.cloudflareinsights.com 'sha256-cxcJbd28ph1n1MkaRcaMuF/qZSpKL2WkvBeEDeyQFqE=' 'sha256-uBYq905YRqbQzfw4kRwvxyrogilPDosZrif7PmFadGI=' 'sha256-7/sD3jnmU/vxPMNiH4TIi9RPlKqJ+82Ueol4pCx4rBk=' 'sha256-NXfDbYIZmVfpN3axohRSIuSDQCSIeDIGFygb5sCtab8=' 'sha256-NQWDtBrhm3rm92BxQrF8NAPaXS89CRRMBLgDa6txz2Y=' 'sha256-e7TzHqqpi9EFkoUg+fnTsD/50NdtNOqJoj8rgTlOO6U=' 'sha256-bfMzjGhHpWKCOvjRKPxJJMiy9eaxO6ArtcYNCt5Pubo=' 'sha256-LC/Y9jSY5QAEmy2iJlXkAm9tnw/ZYV+gENQOgqoZIlE=' 'sha256-Ayy3YnycJLWSH3klWtIEuQl7W3JMZqKdFQrxf5m9pM4=' 'sha256-XX2eyMnU4OfwTP0bgDC7u/blt7yqFyL/MphRdsfr2T8=' 'sha256-OOMRsaZJhXsJIkszdKi8CrVEfe19kPwWdRYhItiKfwg=' 'sha256-Hnln6nYzfhaqAoNAhjhMirQYavqpjO9a1QNd8fv74cE=' 'sha256-35DWfk/j4LLUDVuaJpKPFtL4MtCpLTTdL3LSrgLPyho=' 'sha256-h19Za7cBagXE8fofIt5y2azvKM2h9avj+XMIGwOEQuE=' 'sha256-mNkTbO5fNuHQWnIWq8t0+lLE+0ipF48ZcleN5v7G+vQ=' 'sha256-IilIBi0pkmzaCNxqOg3+/3Ts78f0SySKawVkyFAfXak=' 'sha256-Pib/0EisqhVdmtn0ZHQdteKYoeIa6+nTngqdY+2JX6o=' 'sha256-m0g9aas+7gPemP+r/NRoBYCsXqiVZONdM6JaPv4oQdk=' 'sha256-MIr31gqPWKxduRL+i0U1CL3CXch2QJi+zCCMZRbrgD8=' 'sha256-YxI2SIDnhvG98KuR5MYKQdKBnbHR4gYmHcrWKCB/x4c=' 'sha256-zEQvNFSFsR2gS9amIpb61gEcwNvDcMz9iNHQye9zeAY=' 'sha256-fq8eSsuovwKRTV58FVvS2SrgTboW6sqC6481dwC6m1M=' 'sha256-mbO0V00yFo8/5QBQ8ILTO1eSp8PzaxHfFoX4eL1SiU8=' 'sha256-+2w3KmaTy1q84cpApHjKQeWf98/kbMsT34GpjuK9Iwg=' 'sha256-M9VqMyFdC0GyQVN7OPcptA906NO1LeZl88uwN4DYpVM=' 'sha256-dy20yIMG6/P7eU0HnsjyGgPzbyuOaqQV7BUikYAl8w0=' 'sha256-lGkz6YTFDL9+5g/2hwmaaEVcWZ9/SgKpJR45lhDhskE=' 'sha256-ZLz/oC6HttSUO20irVYIm0Cwf7O/X2fZd29wW2Woj+Q=' 'sha256-Uywl7ANaUipHdAgpf3U14tcwRjseauSWs77O0Ico2jc=' 'sha256-O2er4GHxax8LhhMr0JZngC2HRZ/1M5LVSIJvysJNFCI=' 'sha256-O5YgoqS6XkzZ29yYNI6LUnWNlS/5+E1WPHkWtoNjhWk=' 'sha256-IjxztNxDbnRf5kWITB7+61I2e3k