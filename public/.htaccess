Options -Indexes -MultiViews
DirectoryIndex index

RewriteEngine On

# Canonical HTTPS host. The Virtualmin certificate must cover both names.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^rumman\.app\.br$ [NC]
RewriteRule ^ https://rumman.app.br%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^privacy/?$ /privacidade [R=301,L]
RewriteRule ^delete-account/?$ /excluir-conta [R=301,L]

ErrorDocument 404 /404

<FilesMatch "^[^.]+$">
  ForceType text/html
  Header set Content-Type "text/html; charset=UTF-8"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'sha256-zlDdqmwTwL3tSicJhpCegk2/dgusSGq6NbMizszNktI=' 'sha256-oS03rVHrweXMxZ1SmlEX7FTe0n7CsrlLtyCEtNLTTsk=' 'sha256-pWrKMpvqGqcQF4yIMlozDYWpWtVWb/fbmtl2a1ur3Ug=' 'sha256-NwhwvD1WIvgBgyAnbMTIbjGMGUx4qwmT9O0br7FQ8Ds=' 'sha256-v16vOdRTZWSbGvVyyHhpubjuRrdU1BAgoPdu9Hs2w6E=' 'sha256-qdfWNPuXCT/TvXV0HfDui+VD/7UmgsWqFMKQaC4OonM=' 'sha256-pzR25KwMtztMet5ZsiDUq0waQttPBC48jZXUE7R+8dM=' 'sha256-f1ptUtUqagrA3OM2UvcSccDJ2kV1xgQy6rrfAYhxb4E=' 'sha256-M2DOORPNdcDqwzfR3rhZUIW9K+pVjsUCZLUBMkOghRA=' 'sha256-5peLuQ/VUK+1LDtj+FiusmieCVnA4rtPVEsyDRyKRmg=' 'sha256-mNkTbO5fNuHQWnIWq8t0+lLE+0ipF48ZcleN5v7G+vQ=' 'sha256-6RCDN8z4QyvV2FLfA5opg1ZRGWAd8FFSyqqjDuJ/+fU=' 'sha256-+PoLLVez8B4Zy/2IiW4D344LJ7upzd8XYmFBvVuRCOQ=' 'sha256-/9D6J4YWaWWvTL+2wAOa31BVf8NRMbydd1Sw+mw3dJ0=' 'sha256-pGOhOoy+LIGlrSp1NBVsGSpDn3+hxiaMsSg1t8SlfdM=' 'sha256-0C5xB2BI78oDcn763kyQf9sCarOQgh5zqK8nzJVAt5g=' 'sha256-GMRIIgp3YfAmAOmOvU5bB5L/ozrM/mEOZICbQRRQrbE=' 'sha256-3ESKNUz54MApLIHYwEkvZHU+DAiPFjyZDlW9/E8Gyg0=' 'sha256-gSxR6xeX/a6VoWVEpZEWxprnkP1y0m1C/WIpK8b4duk=' 'sha256-643FC114pPk9mRoT4i0ISrzYITDng801MAyQdjyjLwM=' 'sha256-XVEDY2P4STyZEo9q2VSzIZppaYbFUA06O9ZiPgiEJdI=' 'sha256-wZ7Lmf1PcvrL2TeFQLoG3BLuEPsIYdQW5sFxCDL78qg=' 'sha256-mxc/4ZBsByq/kPLkn/bvK4wifZLK2g+WEaKckDc8ohw=' 'sha256-LXNpDsarHNiyuEdpKBhtyavEYK5CpqPG8H8YXcGyPH0=' 'sha256-eAqG6+6wJqO9LI/smsCPYJplKj24Tchu/5pQAbFlnG4=' 'sha256-6qnqTfJoccgii1F+gNjYsyb2bKklOzVfBZfCafbWAlg=' 'sha256-sqBeCDf3C8dfCBz8EKrIMYt/90vnFj2bNkO0S+E3UJE=' 'sha256-t0QfSobpU0BEkraq/NxTirM9NC/OwbHuwYqr9rxMxt8=' 'sha256-u2zW4hf4CvA6izuMibxA3jPocGWX+CJUnL6KlgZtw0E=' 'sha256-9H6GUzi3JZop6OMJ4UaZVK4Lr7lCEvUxO91XB436Cd8=' 'sha256-KlniFUL86mWvIZKCPEHwRYz1sLUVU6f/g52npD2Ll38=' 'sha256-b0zjYeLl4WDPeqjyvPUntRLTve+WduR8cjNYES1UMW4=' 'sha256-EoIMxjwTNKb2Gggtw7PjGlCMHKzH0/MGqbjAk6Ku6Y