Options -Indexes -MultiViews
DirectoryIndex index

RewriteEngine On

# Canonical HTTPS host. The Virtualmin certificate must cover both names.
RewriteCond %{HTTPS} !=on [OR]
RewriteCond %{HTTP_HOST} !^rumman\.app\.br$ [NC]
RewriteRule ^ https://rumman.app.br%{REQUEST_URI} [R=301,L,NE]

RewriteRule ^privacy/?$ /privacidade [R=301,L]
RewriteRule ^delete-account/?$ /excluir-conta [R=301,L]

ErrorDocument 404 /404

<FilesMatch "^[^.]+$">
  ForceType text/html
  Header set Content-Type "text/html; charset=UTF-8"
  Header set Cache-Control "no-cache, no-store, must-revalidate"
</FilesMatch>

<IfModule mod_headers.c>
  Header always set X-Content-Type-Options "nosniff"
  Header always set X-Frame-Options "DENY"
  Header always set Referrer-Policy "strict-origin-when-cross-origin"
  Header always set Permissions-Policy "camera=(), geolocation=(), microphone=()"
  Header always set Cross-Origin-Opener-Policy "same-origin"
  Header always set Content-Security-Policy "default-src 'self'; base-uri 'self'; connect-src 'self'; font-src 'self'; form-action 'self'; frame-ancestors 'none'; img-src 'self' data:; object-src 'none'; script-src 'self' 'sha256-zlDdqmwTwL3tSicJhpCegk2/dgusSGq6NbMizszNktI=' 'sha256-oS03rVHrweXMxZ1SmlEX7FTe0n7CsrlLtyCEtNLTTsk=' 'sha256-pWrKMpvqGqcQF4yIMlozDYWpWtVWb/fbmtl2a1ur3Ug=' 'sha256-2VIBsn61a2cRx0mpUUZlfpiVcRKRvGq23otm91lK8p8=' 'sha256-FlobwiwAy7AgkZ/Zc+xeO2WoJFiQPVwVWsdxsQ4rTts=' 'sha256-e7TzHqqpi9EFkoUg+fnTsD/50NdtNOqJoj8rgTlOO6U=' 'sha256-J7uZlT8RFWiGZGcKwhz54E+sbDVjtBjdFidHRWv3/UY=' 'sha256-qdfWNPuXCT/TvXV0HfDui+VD/7UmgsWqFMKQaC4OonM=' 'sha256-pzR25KwMtztMet5ZsiDUq0waQttPBC48jZXUE7R+8dM=' 'sha256-f1ptUtUqagrA3OM2UvcSccDJ2kV1xgQy6rrfAYhxb4E=' 'sha256-OOMRsaZJhXsJIkszdKi8CrVEfe19kPwWdRYhItiKfwg=' 'sha256-/GpI21YV4TyzWPbyG7ZydLV7BC7or2ah6zOwrziELyI=' 'sha256-AzYVTJtXLOIcvSO+wJzG77fRuCZNLzgBS9NunOHI+oQ=' 'sha256-IMh2gnjv2X0eeEP5qZbAaSR95wIBTqBq8bJQE212ySc=' 'sha256-mNkTbO5fNuHQWnIWq8t0+lLE+0ipF48ZcleN5v7G+vQ=' 'sha256-HH+InG5NkAj1aGgOddamOQXujTML+YEytX/UwSO8Wmw=' 'sha256-/tITjv/pKEXY6oBLJE3ciyZ5LHBxtnRsyoLNxuP6e9g=' 'sha256-wzsu4QGg25JGy9td81WXsvZFmQ3NnSQNobRFH+kQirU=' 'sha256-Dt0gFvA7twXB1oeHzO1Atl4R9kGPoe8WlGLP//CKElc=' 'sha256-HCUZrzSYUOSxljwoBMzOHTnZ9mXg6FXUpW9Ngn6SbIk=' 'sha256-AMG7UPUMaI10pUpmMaCwJ0tBfsRaxICztZpI9Q+j+34=' 'sha256-HeXczhtXkzrp/8shYxej1XaxQePRNZlCAhqt7+btXsw=' 'sha256-S+s/u2floPmmATaK9UhoG9OV5y5sGLMpHHryJRFdQ0c=' 'sha256-Z6DGBOAh0gNfI4aNNauCDlmMLdgkat7zgg2vR6Q+kDg=' 'sha256-2DY6CcmVtLcvhf3MZVX9V+PAXFP4wdKBoqpmIwU+qCk=' 'sha256-wZ7Lmf1PcvrL2TeFQLoG3BLuEPsIYdQW5sFxCDL78qg=' 'sha256-mxc/4ZBsByq/kPLkn/bvK4wifZLK2g+WEaKckDc8ohw=' 'sha256-LXNpDsarHNiyuEdpKBhtyavEYK5CpqPG8H8YXcGyPH0=' 'sha256-Uywl7ANaUipHdAgpf3U14tcwRjseauSWs77O0Ico2jc=' 'sha256-XbX3I1rd0qtsBuVxMZH/UbX10oSB/kSJmHz19zHhelc=' 'sha256-ZMH3BVvIxwhQZOwVeZ4EP8NtkvqVpjyLbu+RhLtwYIw=' 'sha256-0OiiqrHHX5S2OHZaWgRzXUXpy1nzxyez10i0ZJx7ke4=' 'sha256-sqBeCDf3C8dfCBz8EKrIMYt/90vnFj2bNkO0S+E3UJ